<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>

<AnchorPane prefHeight="620" prefWidth="880"
	xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1"
	fx:controller="com.aptech.projectmgmt.controller.staff.StudentListController">

	<Label fx:id="classNameLabel" layoutX="20" layoutY="20"
		style="-fx-font-size: 16; -fx-font-weight: bold;" text="Student List" />

	<HBox layoutX="20" layoutY="55" spacing="10">
		<Button fx:id="createAccountsBtn"
			text="Create Accounts for Class" />

		<Button fx:id="addStudentBtn" text="+ Add Student to Class" />
	</HBox>

	<TableView fx:id="studentTable" layoutX="20" layoutY="95"
		prefHeight="500" prefWidth="840" AnchorPane.topAnchor="95" AnchorPane.bottomAnchor="20.0" AnchorPane.leftAnchor="20" AnchorPane.rightAnchor="20.0">
		<columns>
			<TableColumn fx:id="avatarColumn" prefWidth="80.0"
				text="Avatar" />

			<TableColumn fx:id="studentCodeColumn" prefWidth="120.0"
				text="Student ID" />

			<TableColumn fx:id="fullNameColumn" prefWidth="190.0"
				text="Full Name" />

			<TableColumn fx:id="emailColumn" prefWidth="250.0"
				text="Email" />

			<TableColumn fx:id="accountStatusColumn"
				prefWidth="198.0" text="Status" />
		</columns>
		<columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/></columnResizePolicy>
	</TableView>
</AnchorPane>
