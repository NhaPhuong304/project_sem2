<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Pagination?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>

<AnchorPane prefHeight="620.0" prefWidth="880.0"
	xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1"
	fx:controller="com.aptech.projectmgmt.controller.staff.StudentListController">

	<!-- Title -->
	<Label fx:id="classNameLabel" text="Student List"
		style="-fx-font-size:16px; -fx-font-weight:bold;"
		AnchorPane.topAnchor="20.0" AnchorPane.leftAnchor="20.0" />

	<!-- Buttons -->
	<HBox spacing="10.0" AnchorPane.topAnchor="55.0"
		AnchorPane.leftAnchor="20.0" AnchorPane.rightAnchor="20.0">

		<Button fx:id="createAccountsBtn"
			text="Create Accounts for Class" prefHeight="34.0" />

		<Button fx:id="addStudentBtn" text="+ Add Student to Class"
			prefHeight="34.0" />
	</HBox>

	<!-- Table -->
	<TableView fx:id="studentTable" AnchorPane.topAnchor="100.0"
		AnchorPane.leftAnchor="20.0" AnchorPane.rightAnchor="20.0"
		AnchorPane.bottomAnchor="80.0">

		<columns>
			<TableColumn fx:id="avatarColumn" text="Avatar"
				prefWidth="80.0" />
			<TableColumn fx:id="studentCodeColumn" text="Student ID"
				prefWidth="120.0" />
			<TableColumn fx:id="fullNameColumn" text="Full Name"
				prefWidth="190.0" />
			<TableColumn fx:id="emailColumn" text="Email"
				prefWidth="250.0" />
			<TableColumn fx:id="accountStatusColumn" text="Status"
				prefWidth="198.0" />
		</columns>

		<columnResizePolicy>
			<TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
		</columnResizePolicy>
	</TableView>

</AnchorPane>