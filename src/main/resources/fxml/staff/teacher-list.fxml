<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<AnchorPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.aptech.projectmgmt.controller.staff.TeacherListController"
            prefWidth="880" prefHeight="620">

    <HBox layoutX="20" layoutY="20" spacing="10">
        <Button fx:id="addTeacherBtn" text="+ Create Teacher" />
    </HBox>

    <TableView fx:id="teacherTable"
               layoutX="20" layoutY="65"
               prefWidth="840" prefHeight="530" AnchorPane.topAnchor="65" AnchorPane.bottomAnchor="20.0" AnchorPane.leftAnchor="20" AnchorPane.rightAnchor="20.0">
        <columns>
            <TableColumn fx:id="avatarColumn" text="Avatar" prefWidth="90.0" />
            <TableColumn fx:id="usernameColumn" text="Username" prefWidth="160.0" />
            <TableColumn fx:id="fullNameColumn" text="Full Name" prefWidth="220.0" />
            <TableColumn fx:id="emailColumn" text="Email" prefWidth="260.0" />
            <TableColumn fx:id="accountStatusColumn" text="Status" prefWidth="110.0" />
        </columns>
		<columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/></columnResizePolicy>
    </TableView>
</AnchorPane>
