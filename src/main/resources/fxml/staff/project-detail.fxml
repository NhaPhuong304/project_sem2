<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.StackPane?>
<AnchorPane xmlns="http://javafx.com/javafx/21"
	xmlns:fx="http://javafx.com/fxml/1"
	fx:controller="com.aptech.projectmgmt.controller.staff.ProjectDetailController"
	prefWidth="900" prefHeight="650">

	<TabPane fx:id="tabPane" layoutX="10" layoutY="10"
		prefWidth="880" prefHeight="630">

		<Tab text="Project Information" closable="false">
			<AnchorPane>
				<Label text="Project Name:" layoutX="20" layoutY="20" />
				<TextField fx:id="projectNameField" layoutX="20"
					layoutY="40" prefWidth="320" />

				<Label text="Semester:" layoutX="370" layoutY="20" />
				<TextField fx:id="semesterField" layoutX="370"
					layoutY="40" prefWidth="160" />

				<Label text="Supervisor:" layoutX="560" layoutY="20" />
				<TextField fx:id="supervisorField" layoutX="560"
					layoutY="40" prefWidth="280" editable="false" />

				<Label text="Start:" layoutX="20" layoutY="95" />
				<DatePicker fx:id="startDatePicker" layoutX="20"
					layoutY="115" prefWidth="180" />

				<Label text="End:" layoutX="220" layoutY="95" />
				<DatePicker fx:id="endDatePicker" layoutX="220"
					layoutY="115" prefWidth="180" />

				<Label text="Report:" layoutX="420" layoutY="95" />
				<DatePicker fx:id="reportDatePicker" layoutX="420"
					layoutY="115" prefWidth="180" />

				<Label text="Description:" layoutX="20" layoutY="170" />
				<TextArea fx:id="descriptionArea" layoutX="20"
					layoutY="190" prefWidth="820" prefHeight="320" wrapText="true" />

				<Button fx:id="editBtn" text="Edit" layoutX="20"
					layoutY="535" />
				<Button fx:id="saveBtn" text="Save" layoutX="110"
					layoutY="535" />
				<Button fx:id="cancelBtn" text="Cancel" layoutX="170"
					layoutY="535" />
				<Button fx:id="completeBtn" text="Completed"
					layoutX="240" layoutY="535" />
			</AnchorPane>
		</Tab>

		<Tab fx:id="groupTab" text="Group" closable="false">
			<AnchorPane>
				<Button fx:id="addGroupBtn" text="+ Create Group " layoutX="10"
					layoutY="10" />

				<StackPane fx:id="groupContentPane" layoutX="10"
					layoutY="50" prefWidth="860" prefHeight="540"
					AnchorPane.topAnchor="50.0" AnchorPane.rightAnchor="10.0"
					AnchorPane.bottomAnchor="10.0" AnchorPane.leftAnchor="10.0">
					<Label fx:id="groupPlaceholderLabel"
						text="This project has no group yet" />
				</StackPane>
			</AnchorPane>
		</Tab>

		<Tab text="Task" closable="false">
			<AnchorPane>
				<Label text="Chose Member:" layoutX="20" layoutY="20" />
				<ComboBox fx:id="taskMemberCombo" layoutX="20" layoutY="45"
					prefWidth="280" />
				<Label text="Status:" layoutX="330" layoutY="20" />
				<ComboBox fx:id="taskStatusFilterCombo" layoutX="330"
					layoutY="45" prefWidth="220" />
				<StackPane fx:id="taskContentPane" layoutX="20"
					layoutY="95" prefWidth="840" prefHeight="505"
					AnchorPane.topAnchor="95.0" AnchorPane.rightAnchor="20.0"
					AnchorPane.bottomAnchor="20.0" AnchorPane.leftAnchor="20.0">
					<Label fx:id="taskPlaceholderLabel"
						text="Select a group to view the task list" />
				</StackPane>
			</AnchorPane>
		</Tab>
	</TabPane>
</AnchorPane>
