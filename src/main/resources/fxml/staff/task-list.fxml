<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.AnchorPane?>
<AnchorPane xmlns="http://javafx.com/javafx/21"
	xmlns:fx="http://javafx.com/fxml/1"
	fx:controller="com.aptech.projectmgmt.controller.staff.TaskListController"
	prefWidth="880" prefHeight="600">

	<TableView fx:id="taskTable" layoutX="10" layoutY="10"
		prefWidth="860" prefHeight="580" AnchorPane.topAnchor="10.0"
		AnchorPane.rightAnchor="10.0" AnchorPane.bottomAnchor="10.0"
		AnchorPane.leftAnchor="10.0">
		<columns>
			<TableColumn fx:id="titleColumn" text="Title"
				prefWidth="180.0" />

			<TableColumn fx:id="estimatedTimeColumn"
				text="Estimated Time" prefWidth="250.0" />

			<TableColumn fx:id="actualTimeColumn" text="Actual Time"
				prefWidth="250.0" />

			<TableColumn fx:id="statusColumn" text="Status"
				prefWidth="110.0" />

			<TableColumn fx:id="assignedToColumn" text="Assigned To"
				prefWidth="170.0" />

			<TableColumn fx:id="reviewedByColumn" text="Reviewed By"
				prefWidth="130.0" />

			<TableColumn fx:id="createdByColumn" text="Assigned By"
				prefWidth="130.0" />

			<TableColumn fx:id="latestRevisionColumn"
				text="Latest Revision" prefWidth="180.0" />

			<TableColumn fx:id="actionColumn" text="Actions"
				prefWidth="160.0" />
		</columns>
	</TableView>
</AnchorPane>
