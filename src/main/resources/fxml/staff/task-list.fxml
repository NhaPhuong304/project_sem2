<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.aptech.projectmgmt.controller.staff.TaskListController"
            prefWidth="1450"
            prefHeight="650">

    <TableView fx:id="taskTable"
               layoutX="10"
               layoutY="10"
               prefWidth="1430"
               prefHeight="630"
               AnchorPane.topAnchor="10.0"
               AnchorPane.rightAnchor="10.0"
               AnchorPane.bottomAnchor="10.0"
               AnchorPane.leftAnchor="10.0">

        <columns>

            <TableColumn fx:id="titleColumn"
                         text="Title"
                         prefWidth="220" />

            <TableColumn fx:id="estimatedTimeColumn"
                         text="Estimated Time"
                         prefWidth="260" />

            <TableColumn fx:id="actualTimeColumn"
                         text="Actual Time"
                         prefWidth="260" />

            <TableColumn fx:id="statusColumn"
                         text="Status"
                         prefWidth="130" />

            <TableColumn fx:id="assignedToColumn"
                         text="Assigned To"
                         prefWidth="220" />

            <TableColumn fx:id="reviewedByColumn"
                         text="Reviewed By"
                         prefWidth="180" />

            <TableColumn fx:id="createdByColumn"
                         text="Assigned By"
                         prefWidth="180" />

            <TableColumn fx:id="latestRevisionColumn"
                         text="Latest Revision"
                         prefWidth="260" />

            <TableColumn fx:id="actionColumn"
                         text="Actions"
                         prefWidth="180" />

        </columns>

        <columnResizePolicy>
            <TableView fx:constant="UNCONSTRAINED_RESIZE_POLICY"/>
        </columnResizePolicy>

    </TableView>

</AnchorPane>