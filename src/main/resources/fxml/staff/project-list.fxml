<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>

<AnchorPane prefHeight="620" prefWidth="880" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.aptech.projectmgmt.controller.staff.ProjectListController">

    <HBox layoutX="20" layoutY="20" spacing="10">
        <ComboBox fx:id="classCombo" prefWidth="250" promptText="Chose Class..." />
        <ComboBox fx:id="semesterCombo" prefWidth="200" promptText="Chose Semester..." />
        <Button fx:id="addProjectBtn" text="+ Create Project" />
    </HBox>

    <TableView fx:id="projectTable" layoutX="20" layoutY="65" prefHeight="530" prefWidth="840" AnchorPane.topAnchor="65" AnchorPane.bottomAnchor="20.0" AnchorPane.leftAnchor="20" AnchorPane.rightAnchor="20.0">
        <columns>
            <TableColumn fx:id="projectNameColumn" prefWidth="200.0" text="Project Name" />
            <TableColumn fx:id="semesterColumn" prefWidth="80.0" text="Semester" />
            <TableColumn fx:id="supervisorColumn" prefWidth="150.0" text="Supervisor" />
            <TableColumn fx:id="startDateColumn" prefWidth="100.0" text="Start" />
            <TableColumn fx:id="endDateColumn" prefWidth="100.0" text="End" />
            <TableColumn fx:id="statusColumn" prefWidth="120.0" text="Status" />
            <TableColumn fx:id="actionColumn" prefWidth="88.57135009765625" text="Detail" />
        </columns>
		<columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/></columnResizePolicy>
    </TableView>
</AnchorPane>
