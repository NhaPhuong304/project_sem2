<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>

<AnchorPane prefHeight="620.0" prefWidth="880.0"
            xmlns="http://javafx.com/javafx/25"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.aptech.projectmgmt.controller.staff.ClassListController">

    <HBox layoutX="20.0" layoutY="20.0" spacing="10.0">
        <TextField fx:id="searchField"
                   prefWidth="260.0"
                   prefHeight="34.0"
                   promptText="Find By Name..." />
        <Button fx:id="addClassBtn"
                text="+ Add Class"
                prefWidth="120.0"
                prefHeight="34.0" />
    </HBox>

    <TableView fx:id="classTable"
               layoutX="20.0" layoutY="65.0"
               prefWidth="840.0" prefHeight="530.0" AnchorPane.topAnchor="80" AnchorPane.bottomAnchor="20.0" AnchorPane.leftAnchor="20" AnchorPane.rightAnchor="20.0">
        <columns>
            <TableColumn fx:id="noColumn" text="STT" prefWidth="45.0" />
            <TableColumn fx:id="classNameColumn" text="Name" prefWidth="165.0" />
            <TableColumn fx:id="academicYearColumn" text="Semester" prefWidth="130.0" />
            <TableColumn fx:id="studentCountColumn" text="Students" prefWidth="95.0" />
            <TableColumn fx:id="managerColumn" text="Staff" prefWidth="145.0" />
            <TableColumn fx:id="createdAtColumn" text="Created_at" prefWidth="140.0" />
            <TableColumn fx:id="actionColumn" text="Action" prefWidth="100.0" />
        </columns>
		<columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/></columnResizePolicy>
    </TableView>
</AnchorPane>