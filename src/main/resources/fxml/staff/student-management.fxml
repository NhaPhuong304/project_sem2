<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>

<AnchorPane prefHeight="620" prefWidth="880"
	styleClass="page-root" stylesheets="@../../css/staff.css"
	xmlns="http://javafx.com/javafx/25"
	xmlns:fx="http://www.w3.org/2001/XMLSchema-instance"
	fx:controller="com.aptech.projectmgmt.controller.staff.StudentManagementController">

	<HBox layoutX="24" layoutY="20" spacing="10">
		<Button fx:id="addStudentBtn" styleClass="add-student-btn"
			text="+ Add Student" />
	</HBox>

	<TableView fx:id="studentTable" layoutX="24" layoutY="64"
		prefHeight="532" prefWidth="832" styleClass="modern-table" AnchorPane.topAnchor="64" AnchorPane.bottomAnchor="20.0" AnchorPane.leftAnchor="24" AnchorPane.rightAnchor="20.0">
		<columns>
			<TableColumn fx:id="avatarColumn" prefWidth="55.0"
				text="Avatar" />

			<TableColumn fx:id="studentCodeColumn" prefWidth="100.0"
				text="Student ID" />

			<TableColumn fx:id="fullNameColumn" prefWidth="160.0"
				text="Full Name" />

			<TableColumn fx:id="emailColumn" prefWidth="200.0"
				text="Email" />

			<TableColumn fx:id="classNameColumn" prefWidth="120.0"
				text="Class" />

			<TableColumn fx:id="createdByColumn" prefWidth="140.0"
				text="Created By" />

			<TableColumn fx:id="actionColumn" prefWidth="160.0"
				text="Actions" />
		</columns>
		<columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/></columnResizePolicy>
	</TableView>
</AnchorPane>