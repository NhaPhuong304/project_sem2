<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.control.TextField?>

<AnchorPane prefHeight="620" prefWidth="880" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.aptech.projectmgmt.controller.admin.AdminStaffListController">

    <HBox layoutX="20" layoutY="20" spacing="10">
    <TextField fx:id="searchField" promptText="Search staff..." />
        <Button fx:id="addTeacherBtn" text="+ Create Staff" />
    </HBox>

    <TableView fx:id="teacherTable" layoutX="20" layoutY="65" prefHeight="530" prefWidth="840" AnchorPane.topAnchor="65" AnchorPane.bottomAnchor="20.0" AnchorPane.leftAnchor="20" AnchorPane.rightAnchor="20.0">
        <columns>
            <TableColumn fx:id="avatarColumn" prefWidth="60.0" text="Avatar" />
            <TableColumn fx:id="usernameColumn" prefWidth="105.0" text="Username" />
            <TableColumn fx:id="fullNameColumn" prefWidth="155.0" text="Full Name" />
            <TableColumn fx:id="emailColumn" prefWidth="180.0" text="Email" />
            <TableColumn fx:id="roleColumn" prefWidth="80.0" text="Position" />
            <TableColumn fx:id="accountStatusColumn" prefWidth="90.0" text="Status" />
            <TableColumn fx:id="actionColumn" prefWidth="140.0" text="Action" />
        </columns>
		<columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/></columnResizePolicy>
    </TableView>
</AnchorPane>
