<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>

<AnchorPane prefHeight="620.0" prefWidth="880.0"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.aptech.projectmgmt.controller.teacher.TeacherInboxController">

    <HBox layoutX="20.0" layoutY="20.0" spacing="10.0">
        <Label text="Hop thu den - Cau hoi tu sinh vien"
               style="-fx-font-size: 18px; -fx-font-weight: bold;" />
        <Button fx:id="refreshBtn" text="Tai lai" />
        <Button fx:id="replyBtn" text="Tra loi" />
    </HBox>

    <TableView fx:id="questionTable"
               layoutX="20.0" layoutY="65.0"
               prefWidth="840.0" prefHeight="520.0">
        <columns>
            <TableColumn fx:id="studentNameColumn" text="Sinh vien" prefWidth="130.0" />
            <TableColumn fx:id="taskTitleColumn" text="Task" prefWidth="150.0" />
            <TableColumn fx:id="questionContentColumn" text="Cau hoi" prefWidth="230.0" />
            <TableColumn fx:id="answerContentColumn" text="Tra loi" prefWidth="180.0" />
            <TableColumn fx:id="createdAtColumn" text="Gui luc" prefWidth="100.0" />
            <TableColumn fx:id="statusColumn" text="Trang thai" prefWidth="100.0" />
        </columns>
    </TableView>
</AnchorPane>