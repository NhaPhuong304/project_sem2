<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>

<AnchorPane prefHeight="620" prefWidth="880"
	xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1"
	fx:controller="com.aptech.projectmgmt.controller.student.MyTaskListController">

	<Label fx:id="projectNameLabel" layoutX="20" layoutY="20"
		style="-fx-font-size: 16; -fx-font-weight: bold;"
		text="Cong viec cua toi" />

	<HBox layoutX="20" layoutY="55" spacing="10">
		<Button fx:id="addTaskBtn" text="+ Create Task" visible="false"
			managed="false" />
		<Button fx:id="askTeacherBtn" text="Ask Teacher" />
	</HBox>

	<TableView fx:id="taskTable" layoutX="20" layoutY="95"
		prefHeight="500" prefWidth="840" AnchorPane.bottomAnchor="25.0"
		AnchorPane.leftAnchor="20.0" AnchorPane.rightAnchor="20.0"
		AnchorPane.topAnchor="95.0">
		<columns>
			<TableColumn fx:id="titleColumn" prefWidth="180.0"
				text="Title" />

			<TableColumn fx:id="estimatedTimeColumn"
				prefWidth="230.0" text="Estimated Time" />

			<TableColumn fx:id="statusColumn" prefWidth="110.0"
				text="Status" />

			<TableColumn fx:id="assignedToColumn" prefWidth="130.0"
				text="Assigned To" />

			<TableColumn fx:id="reviewedByColumn" prefWidth="190.0"
				text="Reviewed By" />

			<TableColumn fx:id="revisionNoteColumn" prefWidth="160.0"
				text="Revision Note" />

			<TableColumn fx:id="actionColumn" prefWidth="200.0"
				text="Actions" />
		</columns>
	</TableView>
</AnchorPane>