<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane prefHeight="620" prefWidth="880" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.aptech.projectmgmt.controller.student.MyProjectListController">

    <Label layoutX="20" layoutY="20" style="-fx-font-size: 16; -fx-font-weight: bold;" text="My Project" />

    <TableView fx:id="projectTable" layoutX="20" layoutY="55" prefHeight="540" prefWidth="840" AnchorPane.topAnchor="55" AnchorPane.bottomAnchor="20.0" AnchorPane.leftAnchor="20" AnchorPane.rightAnchor="20.0">
        <columns>
            <TableColumn fx:id="projectNameColumn" prefWidth="200.0" text="Project Name" />
            <TableColumn fx:id="semesterColumn" prefWidth="90.0" text="Semester" />
            <TableColumn fx:id="supervisorColumn" prefWidth="150.0" text="Supervisor" />
            <TableColumn fx:id="dateRangeColumn" prefWidth="210.0" text="Time" />
            <TableColumn fx:id="statusColumn" prefWidth="90.0" text="Status" />
            <TableColumn fx:id="roleColumn" prefWidth="100.0" text="Role" />
        </columns>
		<columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/></columnResizePolicy>
    </TableView>
</AnchorPane>
