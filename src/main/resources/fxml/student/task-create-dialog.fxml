<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane prefHeight="360" prefWidth="520" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.aptech.projectmgmt.controller.student.TaskCreateDialogController">

    <Label layoutX="20" layoutY="20" text="Title" />
    <TextField fx:id="titleField" layoutX="140" layoutY="16" prefWidth="340" />

    <Label layoutX="20" layoutY="60" text="Description" />
    <TextArea fx:id="descriptionArea" layoutX="140" layoutY="56" prefHeight="70" prefWidth="340" />

    <Label layoutX="20" layoutY="145" text="Start Date" />
    <DatePicker fx:id="startDatePicker" layoutX="140" layoutY="141" prefWidth="160" />

    <Label layoutX="315" layoutY="145" text="Start Time" />
    <TextField fx:id="startTimeField" layoutX="390" layoutY="141" prefWidth="90" text="00:00" />

    <Label layoutX="20" layoutY="190" text="End Date" />
    <DatePicker fx:id="endDatePicker" layoutX="140" layoutY="186" prefWidth="160" />

    <Label layoutX="315" layoutY="190" text="End Time" />
    <TextField fx:id="endTimeField" layoutX="390" layoutY="186" prefWidth="90" text="23:59" />

    <Label layoutX="20" layoutY="235" text="Assignee" />
    <ComboBox fx:id="assignedCombo" layoutX="140" layoutY="231" prefWidth="340" />

    <Label layoutX="20" layoutY="280" text="Reviewer" />
    <ComboBox fx:id="reviewerCombo" layoutX="140" layoutY="276" prefWidth="340" />
</AnchorPane>
