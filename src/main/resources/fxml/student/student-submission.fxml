<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="620.0" prefWidth="900.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.aptech.projectmgmt.controller.student.StudentSubmissionController">
    <top>
        <VBox spacing="4.0">
            <padding>
                <Insets bottom="8.0" left="20.0" right="20.0" top="18.0" />
            </padding>
            <Label style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #0f172a;" text="Submit Project" />
            <Label style="-fx-font-size: 13px; -fx-text-fill: #64748b;" text="The leader uploads the required files and completes the group submission." />
        </VBox>
    </top>

    <center>
        <HBox spacing="18.0">
            <padding>
                <Insets bottom="20.0" left="20.0" right="20.0" top="8.0" />
            </padding>

            <VBox prefWidth="330.0" spacing="10.0">
                <HBox alignment="CENTER_LEFT" spacing="10.0">
                    <Label style="-fx-font-weight: bold; -fx-text-fill: #334155;" text="Assigned requirements" />
                    <Button fx:id="refreshButton" text="Refresh" />
                </HBox>
                <TableView fx:id="targetTable" prefHeight="505.0" styleClass="student-table" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="requestTitleColumn" prefWidth="145.0" text="Requirement" />
                        <TableColumn fx:id="deadlineColumn" prefWidth="105.0" text="Deadline" />
                        <TableColumn fx:id="targetStatusColumn" prefWidth="95.0" text="Status" />
                    </columns>
                </TableView>
            </VBox>

            <VBox spacing="10.0" HBox.hgrow="ALWAYS">
                <VBox spacing="4.0">
                    <Label fx:id="selectedTitleLabel" style="-fx-font-size: 17px; -fx-font-weight: bold; -fx-text-fill: #0f172a;" />
                    <Label fx:id="selectedGroupLabel" style="-fx-text-fill: #475569;" />
                    <Label fx:id="selectedDeadlineLabel" style="-fx-text-fill: #475569;" />
                    <Label fx:id="descriptionLabel" style="-fx-text-fill: #64748b;" wrapText="true" />
                </VBox>

                <Label style="-fx-font-weight: bold; -fx-text-fill: #334155;" text="Required files" />
                <ScrollPane fitToWidth="true" prefHeight="385.0" VBox.vgrow="ALWAYS">
                    <content>
                        <VBox fx:id="fileBox" spacing="8.0">
                            <padding>
                                <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
                            </padding>
                        </VBox>
                    </content>
                </ScrollPane>

                <HBox alignment="CENTER_LEFT" spacing="12.0">
                    <Button fx:id="completeButton" disable="true" styleClass="add-btn" text="Complete Submission" />
                    <Label fx:id="statusLabel" style="-fx-text-fill: #475569;" />
                </HBox>
            </VBox>
        </HBox>
    </center>
</BorderPane>
