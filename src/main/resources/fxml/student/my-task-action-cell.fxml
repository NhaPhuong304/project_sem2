<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Tooltip?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>

<AnchorPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.aptech.projectmgmt.controller.student.MyTaskActionCellController"
            prefWidth="520.0" prefHeight="30.0">

    <HBox spacing="4.0"
          AnchorPane.topAnchor="0.0"
          AnchorPane.rightAnchor="0.0"
          AnchorPane.bottomAnchor="0.0"
          AnchorPane.leftAnchor="0.0">

        <Button fx:id="startButton"
                mnemonicParsing="false"
                text="▶"
                visible="false"
                managed="false"
                styleClass="table-action-button action-start">
            <tooltip>
                <Tooltip fx:id="startTooltip" text="Bat dau (Not started yet)" />
            </tooltip>
        </Button>

        <Button fx:id="submitReviewButton"
                mnemonicParsing="false"
                text="📤"
                visible="false"
                managed="false"
                styleClass="table-action-button action-submit">
            <tooltip>
                <Tooltip text="Submit for Review" />
            </tooltip>
        </Button>

        <Button fx:id="requestRevisionButton"
                mnemonicParsing="false"
                text="🔄"
                visible="false"
                managed="false"
                styleClass="table-action-button action-revision">
            <tooltip>
                <Tooltip text="Revision Request" />
            </tooltip>
        </Button>

        <Button fx:id="completeButton"
                mnemonicParsing="false"
                text="✅"
                visible="false"
                managed="false"
                styleClass="table-action-button action-complete">
            <tooltip>
                <Tooltip text="Confirm Completion" />
            </tooltip>
        </Button>

        <Button fx:id="resubmitButton"
                mnemonicParsing="false"
                text="🔃"
                visible="false"
                managed="false"
                styleClass="table-action-button action-resubmit">
            <tooltip>
                <Tooltip text="Resubmit for Review" />
            </tooltip>
        </Button>

        <Button fx:id="assignButton"
                mnemonicParsing="false"
                text="👤"
                visible="false"
                managed="false"
                styleClass="table-action-button action-assign">
            <tooltip>
                <Tooltip text="Assign" />
            </tooltip>
        </Button>

        <Button fx:id="detailButton"
                mnemonicParsing="false"
                text="👁"
                visible="false"
                managed="false"
                styleClass="table-action-button action-view">
            <tooltip>
                <Tooltip text="Detail" />
            </tooltip>
        </Button>
    </HBox>
</AnchorPane>